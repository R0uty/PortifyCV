{
  "name": "portifycv",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "lint": "eslint .",
    "check:share": "node scripts/check-share-links.mjs",
    "check:reducers": "node scripts/check-reducers.mjs",
    "check:feedback": "node scripts/check-cv-feedback.mjs",
    "check:docx-export": "node scripts/check-docx-export.mjs",
    "check:section-schema": "node scripts/check-section-schema.mjs",
    "check:section-columns": "node scripts/check-section-columns.mjs",
    "check:template-pages": "node scripts/check-template-pages.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --grep-invert @slow",
    "test:e2e:slow": "playwright test --grep @slow",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wrangler": "^4.125.0"
  }
}
