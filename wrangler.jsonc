{
  // Cloudflare Workers static-assets config, fronted by worker/index.js.
  // The worker decides routing itself (matching against src/utils/routes.js
  // + src/utils/pageMeta.js) so it can rewrite each route's title/canonical/
  // description/OG/structured-data at the edge and return a real 404 for
  // unknown paths — plain static-assets SPA fallback (not_found_handling)
  // can't do either, since it has no notion of which paths are real routes
  // vs. typos, and always serves index.html byte-for-byte unedited.
  "name": "portifycv",
  "compatibility_date": "2024-09-23",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
